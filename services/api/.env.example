# Copy to .env.local for development. Never commit real values.

# Port the Express server listens on.
PORT=4000

# MongoDB connection string (Mongoose).
MONGODB_URI=mongodb://localhost:27017/sourcethevin

# Secret used to sign short-lived JWT access tokens. Use a long random string in every environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Origin of the web app allowed to call this API with credentials (CORS).
WEB_ORIGIN=http://localhost:5173

# development | staging | production — set to "production" to mark the refresh cookie Secure.
NODE_ENV=development

# Cloudinary account used to sign direct-from-browser photo uploads for the
# submission wizard (step 5). Find these in the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend account used to send notification emails. If RESEND_API_KEY is unset, emails are
# logged to the console instead of sent — useful for local development.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@sourcethevin.com

# lax | none — SameSite for the refresh cookie. Use "none" when the web app and API are on
# different sites (e.g. *.netlify.app and *.onrender.com); "none" forces the cookie Secure.
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (Render = 1). Defaults to 1 when
# NODE_ENV=production; leave unset locally.
# TRUST_PROXY=1
