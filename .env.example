# ─────────────────────────────────────────────────────────────────────────────
# SourceTheVIN — environment variables
# Copy to .env.local for development. NEVER commit real values.
# The same variable set drives development, staging and production; only the
# values differ. See README.md → "Environments".
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this process believes it is in: development | staging | production
APP_ENV=development

# Public base URL of this deployment (no trailing slash). Used for auth redirects + email links.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon (publishable) key are safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY. Bypasses RLS. Used solely by audited platform routes, migrations and seeds.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SERVER-ONLY. Only needed for the integration test harness to mint test JWTs.
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-chars

# ── Database (SERVER-ONLY) ───────────────────────────────────────────────────
# Direct Postgres connection used by Drizzle migrations, seeds and the RLS test harness.
# Local docker harness default: postgres://postgres:postgres@localhost:54329/sourcethevin
DATABASE_URL=postgres://postgres:postgres@localhost:54329/sourcethevin

# ── Storage buckets (private; accessed only via short-lived signed URLs) ─────
STORAGE_BUCKET_VEHICLE_PHOTOS=vehicle-photos
STORAGE_BUCKET_DOCUMENTS=documents

# ── Email (Resend, SERVER-ONLY) ──────────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_DOMAIN=mail.sourcethevin.com

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature flags ────────────────────────────────────────────────────────────
# Expose /wireframes (auth-free, placeholder data) for client click-through. Off in production.
WIREFRAME_PREVIEW=true

# ── Seeding (local/staging only) ─────────────────────────────────────────────
SEED_PASSWORD=ChangeMe-Now-2026!
