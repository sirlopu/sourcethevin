# Copy to .env.local for development. Never commit real values.

# Port the Express server listens on.
PORT=4000

# MongoDB connection string (Mongoose).
MONGODB_URI=mongodb://localhost:27017/sourcethevin

# Secret used to sign short-lived JWT access tokens. Use a long random string in every environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Origin of the web app allowed to call this API with credentials (CORS).
WEB_ORIGIN=http://localhost:5173

# development | staging | production — set to "production" to mark the refresh cookie Secure.
NODE_ENV=development
